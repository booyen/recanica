{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "gen": "node scripts/gen-registry.mjs",
    "predev": "node scripts/gen-registry.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/gen-registry.mjs",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/gen-registry.mjs && shadcn build --output public/r",
    "test:layout": "playwright test tests/layout.spec.ts",
    "test:qa": "playwright test tests/qa.spec.ts --project=desktop",
    "test:audit": "playwright test tests/layout.spec.ts tests/spec.spec.ts tests/coverage.spec.ts tests/links.spec.ts tests/ux.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@recanica/tokens": "workspace:*",
    "@recanica/ui": "workspace:*",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
