{
  "name": "@recanica/css",
  "version": "0.1.0",
  "description": "Recanica as plain CSS: framework-free components (rc-*) for HTML, WordPress, Laravel, Django, Rails, email-safe pages.",
  "license": "MIT",
  "author": "Aturanica Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booyen/rekanica-des.git",
    "directory": "packages/css"
  },
  "keywords": [
    "css",
    "design-system",
    "recanica",
    "no-framework"
  ],
  "type": "module",
  "style": "dist/recanica.css",
  "exports": {
    ".": "./dist/recanica.css",
    "./min": "./dist/recanica.min.css",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "dependencies": {
    "@recanica/tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
