  "dimension": {
    "radius": {
      "base": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "com.rekanica": {
            "css": "0.75rem",
            "cssVar": "--radius"
          }
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "com.rekanica": {
            "css": "calc(var(--radius) - 4px)"
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "com.rekanica": {
            "css": "calc(var(--radius) - 2px)"
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "com.rekanica": {
            "css": "var(--radius)"
          }
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "com.rekanica": {
            "css": "calc(var(--radius) + 4px)"
          }
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "com.rekanica": {
            "css": "calc(var(--radius) + 8px)"
          }
        }
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px"
      }
    },
    "spacing": {
      "unit": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Base grid. Tailwind p-1 = 4px."
      },
      "gutter": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "com.rekanica": {
            "css": "clamp(1rem, 3vw, 2.5rem)"
          }
        },
        "$description": "Page side padding"
      },
      "section": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": {
          "com.rekanica": {
            "css": "clamp(4rem, 10vw, 8rem)"
          }
        },
        "$description": "Landing section rhythm"
      },
      "section-sm": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "com.rekanica": {
            "css": "clamp(3rem, 6vw, 5rem)"
          }
        }
      },
      "panel": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "com.rekanica": {
            "css": "1.75rem"
          }
        },
        "$description": "Card / stat padding"
      },
      "stack": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "com.rekanica": {
            "css": "2.5rem"
          }
        },
        "$description": "Gap between dashboard blocks"
      },
      "sidebar": {
        "$type": "dimension",
        "$value": "240px",
        "$extensions": {
          "com.rekanica": {
            "css": "15rem"
          }
        }
      }
    },
    "container": {
      "content": {
        "$type": "dimension",
        "$value": "1152px",
        "$extensions": {
          "com.rekanica": {
            "css": "72rem"
          }
        }
      },
      "narrow": {
        "$type": "dimension",
        "$value": "768px",
        "$extensions": {
          "com.rekanica": {
            "css": "48rem"
