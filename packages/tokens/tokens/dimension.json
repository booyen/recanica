{
  "$description": "Size tokens. CSS uses rem/clamp via $extensions.com.recanica.css; native platforms use the px $value.",
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "com.recanica": {
          "css": "0.75rem",
          "cssVar": "--radius"
        }
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "com.recanica": {
          "css": "calc(var(--radius) - 4px)"
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "10px",
      "$extensions": {
        "com.recanica": {
          "css": "calc(var(--radius) - 2px)"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "com.recanica": {
          "css": "var(--radius)"
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.recanica": {
          "css": "calc(var(--radius) + 4px)"
        }
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "com.recanica": {
          "css": "calc(var(--radius) + 8px)"
        }
      }
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Base grid. Tailwind p-1 = 4px."
    },
    "gutter": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.recanica": {
          "css": "clamp(1rem, 3vw, 2.5rem)"
        }
      },
      "$description": "Page side padding"
    },
    "section": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "com.recanica": {
          "css": "clamp(4rem, 10vw, 8rem)"
        }
      },
      "$description": "Landing section rhythm"
    },
    "section-sm": {
      "$type": "dimension",
      "$value": "48px",
      "$extensions": {
        "com.recanica": {
          "css": "clamp(3rem, 6vw, 5rem)"
        }
      }
    },
    "panel": {
      "$type": "dimension",
      "$value": "28px",
      "$extensions": {
        "com.recanica": {
          "css": "1.75rem"
        }
      },
      "$description": "Card / stat padding"
    },
    "stack": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "com.recanica": {
          "css": "2.5rem"
        }
      },
      "$description": "Gap between dashboard blocks"
    },
    "sidebar": {
      "$type": "dimension",
      "$value": "240px",
      "$extensions": {
        "com.recanica": {
          "css": "15rem"
        }
      }
    },
    "flow": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "com.recanica": {
          "css": "1.25rem"
        }
      },
      "$description": "Gap between consecutive blocks in a column (paragraph \u2192 table \u2192 paragraph). Owned by the .flow container, never by the blocks."
    },
    "$description": "Visual rhythm, by role. Pages and components use these roles, never raw numbers: inset (inside a surface) \u00b7 group (within a group: heading\u2192content, label\u2192field) \u00b7 flow (between blocks) \u00b7 stack (between sections) \u00b7 section (page bands on marketing pages).",
    "group": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "com.recanica": {
          "css": "0.75rem"
        }
      },
      "$description": "Within a group: a heading and its content, a label and its field."
    },
    "inset-sm": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.recanica": {
          "css": "1rem"
        }
      },
      "$description": "Padding inside compact surfaces (list rows, small cards)."
    },
    "inset": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "com.recanica": {
          "css": "1.25rem"
        }
      },
      "$description": "Padding inside surfaces (cards, tables' edge inset)."
    }
  },
  "container": {
    "content": {
      "$type": "dimension",
      "$value": "1152px",
      "$extensions": {
        "com.recanica": {
          "css": "72rem"
        }
      }
    },
    "narrow": {
      "$type": "dimension",
      "$value": "768px",
      "$extensions": {
        "com.recanica": {
          "css": "48rem"
        }
      }
    },
    "copy": {
      "$type": "dimension",
      "$value": "640px",
      "$extensions": {
        "com.recanica": {
          "css": "40rem"
        }
      }
    }
  }
}
