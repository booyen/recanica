{
  "$description": "Geist Sans / Geist Mono. Weights: 300 metrics, 400 everything else, 500 buttons. Never bold.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$extensions": {
          "com.rekanica": {
            "css": "var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif"
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "monospace"
        ],
        "$extensions": {
          "com.rekanica": {
            "css": "var(--font-geist-mono), ui-monospace, monospace"
          }
        }
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      }
    }
  },
  "text": {
    "xs": {
      "$type": "typography",
      "$value": {
        "fontSize": "12px",
        "lineHeight": 1.333
      }
    },
    "sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "14px",
        "lineHeight": 1.43
      }
    },
    "base": {
      "$type": "typography",
      "$value": {
        "fontSize": "16px",
        "lineHeight": 1.5
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontSize": "24px",
        "lineHeight": 1.25,
        "letterSpacing": "-0.015em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "30px",
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      }
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontSize": "40px",
        "lineHeight": 1,
        "letterSpacing": "-0.03em"
      }
    },
    "display-sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "36px",
        "lineHeight": 1.1
      }
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontSize": "48px",
        "lineHeight": 1.05
      }
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "64px",
        "lineHeight": 1,
        "letterSpacing": "-0.035em"
      }
    }
  }
}